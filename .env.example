# Copy to .env, then fill from Sakura3 Production's Connect > Session pooler.
# This workspace cannot reach the project's IPv6-only direct endpoint.
# For a durable MCP deployment, use a database role that can only read the
# three source tables. The postgres role is suitable only for a local test.
SAKURA_DB_HOST=replace_with_session_pooler_host
SAKURA_DB_PORT=5432
SAKURA_DB_NAME=postgres
SAKURA_DB_USER=replace_with_pooler_username
SAKURA_DB_PASSWORD=replace_with_password
